---
import { labs } from "../../lib/labs";
---

<div class="lab-grid">
  {labs.map((lab) => (
    <a class="lab-card" href={`analytic-geometry/lab/#${lab.slug}`}>
      <span class="lab-card__status">{lab.status}</span>
      <strong>{lab.title}</strong>
      <code>{lab.formula}</code>
      <span>{lab.description}</span>
    </a>
  ))}
</div>
